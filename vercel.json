{
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/canteen-config",
      "destination": "/api/canteen-config.js"
    },
    {
      "source": "/api/orders/:id/status",
      "destination": "/api/orders"
    },
    {
      "source": "/api/orders/:id",
      "destination": "/api/orders"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
